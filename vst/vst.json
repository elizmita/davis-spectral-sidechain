{
  "name": "Spectral Sidechain",
  "vendor": "DAVIS",
  "uid": "DSpS",
  "version": 1050,
  "so": "spectral_sidechain.so",
  "params": "params.json",
  "effect": true,
  "build": {
    "root": "..",
    "sources": [
      "src/engine.cpp"
    ],
    "cflags": [
      "-O2"
    ],
    "libs": [
      "-lm"
    ]
  },
  "layout": "layout.conf",
  "art": "html",
  "presets": "presets.json",
  "defines": {
    "HAS_DISPLAY_REV": 1,
    "DISPLAY_REV_NO_UPDATE": 1,
    "DISPLAY_REV_THREAD": 1
  },
  "targets": [
    "armv7"
  ]
}